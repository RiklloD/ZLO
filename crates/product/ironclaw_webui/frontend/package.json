{
  "name": "ironclaw-webui-v2-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Build tooling for the WebUI v2 SPA. Vite builds the TypeScript source and public assets; the Rust crate's build.rs runs the same build into Cargo's OUT_DIR and embeds that output.",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.22 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && pnpm check:bundle",
    "check:bundle": "node --experimental-strip-types scripts/check-bundle-budgets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:conventions && pnpm typecheck",
    "lint:conventions": "node --experimental-strip-types scripts/check-source-conventions.ts",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "vendor": "bash vendor.sh",
    "all": "bash build.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@tanstack/react-query": "5.108.1",
    "dompurify": "3.4.18",
    "event-source-plus": "0.1.15",
    "gemoji": "8.1.0",
    "highlight.js": "11.12.0",
    "marked": "18.2.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-hot-toast": "2.6.1",
    "react-router": "8.5.2",
    "remark-gemoji": "8.0.0",
    "streamdown": "2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "storybook": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@chromatic-com/storybook": "5.6.0",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-mcp": "10.6.7",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.1"
  }
}
