#!/usr/bin/env bash
set -euo pipefail
# Hermetic git env: see the note in .githooks/pre-push.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_NAMESPACE

# Unified pre-commit hook:
#   1. Version-bump check when WIT definitions change.
#   2. Static safety checks on staged Rust files (scripts/pre-commit-safety.sh).
# Install: git config core.hooksPath .githooks  (or `just setup`)

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only)

# The WIT branch is depth-agnostic on purpose. `wit/` lives inside the
# `ironclaw_wasm` crate (`crates/lanes/ironclaw_wasm/`). Pinned by
# `scripts/ci/test_pre_commit_staged_paths.py` against the live crate inventory.
NEEDS_CHECK=false
if echo "$STAGED" | grep -qE '^crates/([^/]+/)*ironclaw_wasm/wit/'; then
    NEEDS_CHECK=true
fi

if $NEEDS_CHECK; then
    echo "pre-commit: checking version bumps..."
    if ! "$REPO_ROOT/scripts/check-version-bumps.sh"; then
        echo ""
        echo "Commit blocked: version bump check failed."
        echo "Bump versions in the relevant registry JSON and/or WIT package declaration."
        echo "To bypass: git commit --no-verify"
        exit 1
    fi
fi

# Static Rust safety checks & composition mass ratchet (only runs on staged .rs
# or composition-budget edits; fast no-op otherwise).
if [ "${IRONCLAW_PRECOMMIT_SAFETY:-1}" = "1" ] && [ -x "$REPO_ROOT/scripts/pre-commit-safety.sh" ]; then
    "$REPO_ROOT/scripts/pre-commit-safety.sh"
fi

# Reborn WebUI i18n parity (crates/product/ironclaw_webui/frontend/src/i18n/*.ts)
# is enforced by the frontend's own tooling (`just webui` / `pnpm lint`).
