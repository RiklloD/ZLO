{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot_id", "context", "event"],
  "properties": {
    "slot_id": { "type": "string" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "thread_id": { "type": ["string", "null"] } }
    },
    "event": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string" },
        "payload": {}
      }
    }
  }
}
